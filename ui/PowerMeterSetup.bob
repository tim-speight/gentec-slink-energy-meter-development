          <expression>false</expression>
        </exp>
        <exp bool_exp="pv0 != 0 &amp;&amp; pv0 != 1">
          <expression>true</expression>
        </exp>
        <pv_name>$(EM):AcquisitionState</pv_name>
      </rule>
    </rules>
