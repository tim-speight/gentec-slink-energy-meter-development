<?xml version="1.0" encoding="UTF-8"?>
<!--Saved on 2024-08-05 13:26:57 by epacdiag1-->
<display version="2.0.0">
  <width>640</width>
  <height>55</height>
  <background_color>
    <color red="240" green="240" blue="240">
    </color>
  </background_color>
  <actions>
  </actions>
  <grid_step_x>6</grid_step_x>
  <grid_step_y>6</grid_step_y>
  <widget type="label" version="2.0.0">
    <name>pv name</name>
    <text>$(EM):Name</text>
    <x>12</x>
    <y>19</y>
    <width>257</width>
    <height>18</height>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>2</vertical_alignment>
    <actions>
    </actions>
    <border_width>1</border_width>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>$(DEVICE)-TFL:OverallStatus</pv_name>
    <x>294</x>
    <y>19</y>
    <width>54</width>
    <height>18</height>
    <background_color>
      <color red="0" green="64" blue="128">
      </color>
    </background_color>
    <format>6</format>
    <precision>0</precision>
    <show_units>false</show_units>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="colour" prop_id="background_color" out_exp="false">
        <exp bool_exp="pvStr0==&quot;OK&quot;">
          <value>
            <color red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pvStr0==&quot;WARNING&quot; &amp;&amp; pv1==0">
          <value>
            <color red="128" green="128" blue="128">
            </color>
          </value>
        </exp>
        <exp bool_exp="pvStr0==&quot;WARNING&quot; &amp;&amp; pv1==1">
          <value>
            <color name="Minor" red="255" green="128" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pvStr0==&quot;ERROR&quot; &amp;&amp; pv1==0">
          <value>
            <color red="128" green="128" blue="128">
            </color>
          </value>
        </exp>
        <exp bool_exp="pvStr0==&quot;ERROR&quot; &amp;&amp; pv1==1">
          <value>
            <color name="Major" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pvStr0==&quot;DISCONNECTED&quot;">
          <value>
            <color red="128" green="128" blue="128">
            </color>
          </value>
        </exp>
        <pv_name>$(pv_name)</pv_name>
        <pv_name>sim://ramp(0,1,0.5)</pv_name>
      </rule>
    </rules>
    <border_width>1</border_width>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <file>slink_graph.bob</file>
        <macros>
          <EM>$(EM)</EM>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>window</target>
        <description>Open Display</description>
      </action>
    </actions>
    <text>Graph</text>
    <x>438</x>
    <y>6</y>
    <width>65</width>
    <height>38</height>
    <tooltip>Meter Reading</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <confirm_message></confirm_message>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_1</name>
    <actions>
      <action type="open_display">
        <file>PowerMeterSetup.bob</file>
        <macros>
          <EM>$(EM)</EM>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>tab</target>
        <description>Open Display</description>
      </action>
    </actions>
    <text>Settings</text>
    <x>570</x>
    <y>6</y>
    <width>65</width>
    <height>38</height>
    <tooltip>Meter Settings</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button</name>
    <actions>
      <action type="open_display">
        <file>statsView.bob</file>
        <macros>
          <EM>$(EM)</EM>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>tab</target>
        <description>Open Display</description>
      </action>
    </actions>
    <text>RMS</text>
    <x>516</x>
    <y>6</y>
    <width>42</width>
    <height>38</height>
    <tooltip>$(actions)</tooltip>
    <confirm_message></confirm_message>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_2</name>
    <actions>
      <action type="open_display">
        <file>PowerMeterView.bob</file>
        <macros>
          <EM>$(EM)</EM>
          <DEVICE>$(DEVICE)</DEVICE>
        </macros>
        <target>window</target>
        <description>Open Display</description>
      </action>
    </actions>
    <text>View</text>
    <x>360</x>
    <y>6</y>
    <width>65</width>
    <height>38</height>
    <tooltip>Meter Reading</tooltip>
    <border_alarm_sensitive>false</border_alarm_sensitive>
    <confirm_message></confirm_message>
  </widget>
</display>
