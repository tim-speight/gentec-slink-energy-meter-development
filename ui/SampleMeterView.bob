    <widget type="action_button" version="3.0.0">
      <name>Action Button</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <pv_name>$(pv_name).DISA</pv_name>
          <value>0</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):editable.VAL</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):startable</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):pauseable</pv_name>
          <value>0</value>
          <description>WritePV</description>
        </action>
      </actions>
      <pv_name>$(EM):measurement</pv_name>
      <text>Start</text>
      <x>288</x>
      <y>1</y>
      <width>122</width>
      <height>31</height>
      <background_color>
        <color name="OK" red="0" green="255" blue="0">
        </color>
      </background_color>
      <rules>
        <rule name="Disable" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0 == 1 || pv2 &gt;= pv1">
            <value>false</value>
          </exp>
          <pv_name>$(EM):startable</pv_name>
          <pv_name>$(EM):duration</pv_name>
          <pv_name>$(EM):elapsedTime</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_1</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <pv_name>$(pv_name).DISA</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):startable</pv_name>
          <value>0</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):pauseable</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
      </actions>
      <pv_name>$(EM):measurement</pv_name>
      <text>Pause</text>
      <x>288</x>
      <y>37</y>
      <width>122</width>
      <height>31</height>
      <background_color>
        <color name="ActiveText" red="255" green="255" blue="0">
        </color>
      </background_color>
      <rules>
        <rule name="Disable" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0 == 1">
            <value>false</value>
          </exp>
          <pv_name>$(EM):pauseable</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>Action Button_2</name>
      <actions execute_as_one="true">
        <action type="write_pv">
          <pv_name>$(EM):measurement.DISA</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(pv_name).PROC</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):editable</pv_name>
          <value>0</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):startable</pv_name>
          <value>0</value>
          <description>WritePV</description>
        </action>
        <action type="write_pv">
          <pv_name>$(EM):pauseable</pv_name>
          <value>1</value>
          <description>WritePV</description>
        </action>
      </actions>
      <pv_name>$(EM):reset</pv_name>
      <text>Reset</text>
      <x>288</x>
      <y>73</y>
      <width>122</width>
      <height>31</height>
      <background_color>
        <color name="Major" red="255" green="0" blue="0">
        </color>
      </background_color>
      <border_alarm_sensitive>false</border_alarm_sensitive>
    </widget>
    <widget type="led" version="2.0.0">
      <name>LED</name>
      <pv_name>$(EM):measurement.DISA</pv_name>
      <bit>0</bit>
      <x>245</x>
      <y>76</y>
      <width>26</width>
      <height>26</height>
      <off_color>
        <color name="OK" red="0" green="255" blue="0">
        </color>
      </off_color>
      <on_color>
        <color name="Off" red="60" green="100" blue="60">
        </color>
      </on_color>
      <actions>
      </actions>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>Text Input</name>
      <pv_name>$(EM):duration</pv_name>
      <x>120</x>
      <y>6</y>
      <width>153</width>
      <height>31</height>
      <background_color>
        <color name="WritePV_Background" red="128" green="255" blue="255">
        </color>
      </background_color>
      <actions>
      </actions>
      <rules>
        <rule name="Disable while running" prop_id="enabled" out_exp="false">
          <exp bool_exp="pv0 == 1">
            <value>false</value>
          </exp>
          <pv_name>$(EM):editable</pv_name>
        </rule>
        <rule name="Grey out" prop_id="background_color" out_exp="false">
          <exp bool_exp="pv0 == 1">
            <value>
              <color name="Read_Background" red="240" green="240" blue="240">
              </color>
            </value>
          </exp>
          <pv_name>$(EM):editable</pv_name>
        </rule>
      </rules>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <border_color>
        <color red="0" green="128" blue="255">
        </color>
      </border_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label</name>
      <text>Max Pulse Count</text>
      <y>6</y>
      <width>121</width>
      <height>31</height>
      <vertical_alignment>1</vertical_alignment>
      <actions>
      </actions>
      <border_color>
        <color red="0" green="128" blue="255">
        </color>
      </border_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Label_11</name>
      <text>Pulse Count</text>
      <y>36</y>
      <width>121</width>
      <height>31</height>
      <vertical_alignment>1</vertical_alignment>
      <actions>
      </actions>
      <border_color>
        <color red="0" green="128" blue="255">
        </color>
      </border_color>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Text Update_7</name>
      <pv_name>$(EM):elapsedTime</pv_name>
      <x>120</x>
      <y>36</y>
      <width>153</width>
      <height>31</height>
      <vertical_alignment>1</vertical_alignment>
      <wrap_words>false</wrap_words>
      <actions>
      </actions>
      <border_alarm_sensitive>false</border_alarm_sensitive>
      <border_color>
        <color red="0" green="128" blue="255">
        </color>
      </border_color>
    </widget>
  </widget>
</display>
