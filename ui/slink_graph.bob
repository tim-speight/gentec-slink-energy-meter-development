    <y>41</y>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_3</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(EM):StopAcquisition.PROC</pv_name>
        <value>1</value>
        <description>StopACQ</description>
      </action>
    </actions>
    <text>▪</text>
    <x>708</x>
    <y>18</y>
    <width>42</width>
    <height>42</height>
    <font>
      <font family="Liberation Sans" style="REGULAR" size="36.0">
      </font>
    </font>
    <background_color>
      <color name="Read_Background" red="240" green="240" blue="240">
      </color>
    </background_color>
    <rules>
      <rule name="Colourize" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color name="Read_Background" red="240" green="240" blue="240">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>
            <color name="Button_Background" red="210" green="210" blue="210">
            </color>
          </value>
        </exp>
        <pv_name>$(EM):AcquisitionState.VAL</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
    <confirm_message></confirm_message>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Action Button_4</name>
    <actions>
      <action type="write_pv">
        <pv_name>$(EM):StartAcquisition.PROC</pv_name>
        <value>1</value>
        <description>StartACQ</description>
      </action>
    </actions>
    <text>▶</text>
    <x>648</x>
    <y>18</y>
    <width>42</width>
    <height>42</height>
    <rules>
      <rule name="Colourize" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color name="Button_Background" red="210" green="210" blue="210">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>
            <color name="Read_Background" red="240" green="240" blue="240">
            </color>
          </value>
        </exp>
        <pv_name>$(EM):AcquisitionState.VAL</pv_name>
      </rule>
    </rules>
    <tooltip>$(actions)</tooltip>
    <confirm_message></confirm_message>
  </widget>
</display>
