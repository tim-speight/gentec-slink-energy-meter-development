<display version="2.0.0">
  <macros>
    <DEVICE>$(DEVICE)</DEVICE>
    <EM>$(EM)</EM>
  </macros>
  <width>1024</width>
  <height>380</height>
  <background_color>
    <color red="240" green="240" blue="240">
    </color>
  </background_color>
  <actions>
  </actions>
  <grid_step_x>6</grid_step_x>
  <grid_step_y>6</grid_step_y>
  <widget type="xyplot" version="3.0.0">
    <name>Slink Display</name>
    <x>12</x>
    <y>84</y>
    <width>1004</width>
    <height>265</height>
    <background_color>
      <color red="0" green="0" blue="0">
      </color>
    </background_color>
    <show_toolbar>true</show_toolbar>
    <actions>
    </actions>
    <tooltip></tooltip>
    <x_axis>
      <title>Secs since runtime</title>
      <autoscale>true</autoscale>
      <log_scale>false</log_scale>
      <minimum>0.0</minimum>
      <maximum>1000.0</maximum>
      <show_grid>true</show_grid>
      <title_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </title_font>
      <scale_font>
        <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
        </font>
      </scale_font>
      <visible>true</visible>
    </x_axis>
    <y_axes>
      <y_axis>
        <title>Energy [J]</title>
        <autoscale>false</autoscale>
        <log_scale>false</log_scale>
        <minimum>0.0</minimum>
        <maximum>10.0</maximum>
        <show_grid>true</show_grid>
        <title_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </title_font>
        <scale_font>
          <font name="Default" family="Liberation Sans" style="REGULAR" size="14.0">
          </font>
        </scale_font>
        <on_right>false</on_right>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>Energy Readout</name>
        <x_pv></x_pv>
        <y_pv>$(EM):CalibratedValue</y_pv>
        <err_pv></err_pv>
        <axis>0</axis>
        <trace_type>1</trace_type>
        <color>
          <color name="Yellow" red="255" green="255" blue="0">
          </color>
        </color>
        <line_width>1</line_width>
        <line_style>0</line_style>
        <point_type>5</point_type>
        <point_size>4</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>txtWavelengthVal</name>
    <pv_name>$(EM):Wavelength</pv_name>
    <x>763</x>
    <y>349</y>
    <width>83</width>
    <height>26</height>
    <background_color>
      <color red="0" green="0" blue="0" alpha="0">
      </color>
    </background_color>
    <actions>
    </actions>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lblWavelength</name>
    <text>Wavelength:</text>
    <x>672</x>
    <y>349</y>
    <width>91</width>
    <height>26</height>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
    <vertical_alignment>1</vertical_alignment>
    <actions>
    </actions>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>txtEnergyReadingVal</name>
    <text>###### </text>
    <x>6</x>
    <y>18</y>
    <width>524</width>
    <height>50</height>
    <font>
      <font family="Segoe UI" style="BOLD" size="35.64356435643565">
      </font>
    </font>
    <foreground_color>
      <color red="127" green="127" blue="127">
      </color>
    </foreground_color>
    <transparent>false</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="RunTimeColour" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0==2">
          <value>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==1">
          <value>
            <color name="STOP" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(EM):AcquisitionState.VAL</pv_name>
      </rule>
    </rules>
    <scripts>
      <script file="EmbeddedJs">
        <text><![CDATA[importPackage(Packages.org.csstudio.opibuilder.scriptUtil);
var value = PVUtil.getDouble(pvs[0]);
var scale = PVUtil.getDouble(pvs[1]);

var scaleFactor = 1;

if (scale <= 6) {
	scaleFactor = 1000000000000;
} else if (scale <= 12) {
	scaleFactor = 1000000000;
} else if (scale <= 17) {
	scaleFactor = 1000000;
} else if (scale <= 23) {
	scaleFactor = 1000;
} else if (scale <= 29) {
	scaleFactor = 1;
} else if (scale <= 33) {
	scaleFactor = 0.001
}

var result = value * scaleFactor;

widget.setPropertyValue("text", result.toFixed(3));]]></text>
        <pv_name>$(EM):CalibratedValue</pv_name>
        <pv_name>$(EM):Scale</pv_name>
        <pv_name>sim://ramp(0,1,0.1)</pv_name>
      </script>
    </scripts>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>txtEnergyReadingUnit</name>
    <x>456</x>
    <y>18</y>
    <width>163</width>
    <height>50</height>
    <font>
      <font family="Segoe UI" style="REGULAR" size="23.762376237623762">
      </font>
    </font>
    <foreground_color>
      <color red="127" green="127" blue="127">
      </color>
    </foreground_color>
    <background_color>
      <color red="255" green="255" blue="255">
      </color>
    </background_color>
    <format>1</format>
    <precision>4</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <wrap_words>false</wrap_words>
    <actions>
    </actions>
    <rules>
      <rule name="RunTimeColour" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0==1">
          <value>
            <color name="OK" red="0" green="255" blue="0">
            </color>
          </value>
        </exp>
        <exp bool_exp="pv0==2">
          <value>
            <color name="STOP" red="255" green="0" blue="0">
            </color>
          </value>
        </exp>
        <pv_name>$(EM):AcquisitionState.VAL</pv_name>
      </rule>
    </rules>
    <scripts>
      <script file="EmbeddedJs">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil
var pv0 = PVUtil.getDouble(pvs[0]);
if(pv0>35)
	widget.setPropertyValue("text","MJ");
else if(pv0>29)
	widget.setPropertyValue("text","kJ");
else if(pv0>23)
	widget.setPropertyValue("text","J");
else if(pv0>17)
	widget.setPropertyValue("text","mJ");
else if(pv0>11)
	widget.setPropertyValue("text","µJ");
else if(pv0>5)
	widget.setPropertyValue("text","nJ");
else 
	widget.setPropertyValue("text","pJ");
]]></text>
        <pv_name>$(EM):Scale</pv_name>
        <pv_name>sim://ramp(0,1,0.1)</pv_name>
      </script>
    </scripts>
    <border_color>
      <color red="0" green="128" blue="255">
      </color>
    </border_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>lblDeviceName</name>
    <text>Device: $(DEVICE)</text>
    <x>780</x>
    <y>41</y>
    <width>223</width>
    <height>26</height>
    <font>
      <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
