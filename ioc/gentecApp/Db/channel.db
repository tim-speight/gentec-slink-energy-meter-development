# gentec channel database
# Database for Gentec S-Link Power & Energy Monitor
#
# substitutions:
# head  - head name
# port    - asyn port
# channel - channel (1/2)
# (base unit J/W comes from $(device):$(head):BaseUnit, see head.template)

################################################################################
# Channel Status - reads:
#   Wavelength
#   Scale
#   Trigger Level
#   Attenuator setting
#   External trigger setting
#   Anticipation
#   Energy mode
#
record(bo, "$(device):$(head):Status"){
    field(DESC,"Channel status")
    # Background telemetry poll. RBVs are also refreshed at the edges:
    # after every setter, when streaming stops and on reconnect.
    # Suppressed while any channel streams (shared port, see slink.db).
    field(SCAN, "$(STATUS_SCAN=5 second)")
    field(SDIS, "$(device):Streaming")
    field(DISV, "1")
    field(DTYP,"stream")
    field(OUT, "@gentecSLink.proto get_status($(channel),$(device),$(head)) $(port)")
    field(FLNK, "$(device):$(head):Wavelength")
    field(PINI, "YES")
}

################################################################################
# Channel wavelength 
#
record(longin, "$(device):$(head):Wavelength"){
    alias("$(device):$(head):Wavelength_RBV")
    field(DESC, "Wavelength")
    field(EGU,  "nm")
    field(LOPR, "0")
    field(HOPR, "100000")
    field(LOLO, "-1")
    field(LOW,  "0")
    field(LLSV, "MAJOR")
    field(LSV,  "MINOR")
    field(FLNK, "$(device):$(head):Scale")
}

################################################################################
# Channel scale 
#

record(longin, "$(device):$(head):Scale") {
    field(DESC, "Raw scale index from device")
    field(FLNK, "$(device):$(head):ScaleConvert")
}

record(aSub, "$(device):$(head):ScaleConvert") {
    field(DESC, "Convert index to scale string")
    field(INPA, "$(device):$(head):Scale")
    field(FTA,  "LONG")
    field(INPB, "$(device):$(head):BaseUnit")
    field(FTB,  "STRING")
    field(FTVA, "STRING")
    field(NEVA, 1)
    field(SNAM, "energyIntToStr")
    field(OUTA, "$(device):$(head):ScaleString PP")
}
record(stringin, "$(device):$(head):ScaleString") {
    # RBV for SetScale (both use the scale string, e.g. 10nJ)
    alias("$(device):$(head):Scale_RBV")
    field(DESC, "Current Scale (readable)")
    field(INP, "$(device):$(head):ScaleConvert.VALA ")
    field(FLNK, "$(device):$(head):TrigLev")

}

record(scalcout, "$(device):$(head):EguSetter"){
    field(DESC, "Unit for scale value")
    # SI prefix from the selected range, base unit (J/W) as commissioned
    # in head.substitutions (EGU column) via BaseUnit.
    field(INPA, "$(device):$(head):Scale CP")
    field(INAA, "$(device):$(head):BaseUnit CP")
    field(CALC, "(A<6?'p':A<12?'n':A<18?'μ':A<24?'m':A<30?'':A<36?'k':'M')+AA")
    field(OUT, "$(device):$(head):ScaledValue.EGU PP")
}

################################################################################
# Channel trigger level 
#
record(ai, "$(device):$(head):TrigLev"){
    alias("$(device):$(head):TrigLev_RBV")
    field(DESC, "Trigger Level")
    field(DTYP, "Raw Soft Channel")
    field(LINR, "LINEAR")
    field(ESLO, "0.048828125")
    field(EOFF, "0")
    field(EGU,  "%")
    field(PREC, "1")
    field(LOPR, "0.0")
    field(HOPR, "100.0")
    field(LOW,  "0")
    field(HIGH, "100")
    field(LOLO, "-0.1")
    field(HIHI, "100.1")
    field(LSV,  "MINOR")
    field(HSV,  "MINOR")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(device):$(head):Attenuator")
}

################################################################################
# Channel attenuator
#
record(bi, "$(device):$(head):Attenuator"){
    alias("$(device):$(head):Attenuator_RBV")
    field(DESC, "Attenuator")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):ExtTrig")
}

################################################################################
# Channel external trigger
#
record(bi, "$(device):$(head):ExtTrig"){
    alias("$(device):$(head):ExtTrig_RBV")
    field(DESC, "External Trigger")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):Anticipation")
}

################################################################################
# Channel anticipation
#
record(bi, "$(device):$(head):Anticipation"){
    alias("$(device):$(head):Anticipation_RBV")
    field(DESC, "Anticipation")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):EnergyMode")
}

################################################################################
# Channel energy mode
#
record(bi, "$(device):$(head):EnergyMode"){
    alias("$(device):$(head):EnergyMode_RBV")
    field(DESC, "Energy Mode")
    field(ZNAM, "Disabled (Power Mode)")
    field(ONAM, "Enabled")
}

################################################################################
# Energy Mode
#
record(bo, "$(device):$(head):SetEnergyMode")
{
    field(DESC, "Energy Mode")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_en_mode($(channel)) $(port)")
    # Manual p.33: *EM requires acquisition stopped (*CS) first
    field(SDIS, "$(device):$(head):DisReadingValue")
    field(DISV, "1")
    field(DISS, "MINOR")
    field(ZNAM, "Disabled (Power Mode)")
    field(ONAM, "Enabled")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Enable/Disable Attenuator
#
record(bo, "$(device):$(head):SetAttenuator")
{
    field(DESC, "Attenuator")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_atten($(channel)) $(port)")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Enable/Disable Anticipation
#
record(bo, "$(device):$(head):SetAnticipation")
{
    field(DESC, "Anticipation")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_antic($(channel)) $(port)")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Wavelength
#
record(longout, "$(device):$(head):SetWavelength") 
{
    field(DESC, "Wavelength")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_wavelen($(channel)) $(port)")
    field(EGU,  "nm")
    field(LOPR, "0")
    field(HOPR, "100000")
    field(DRVL, "0")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Trigger Level
#
record(ao, "$(device):$(head):SetTrigLev")
{
    field(DESC, "Trigger Level")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_triglev($(channel)) $(port)")
    field(EGU,  "%")
    field(PREC, "1")
    # *TL takes exactly 4 characters (manual p.32); 100.0 would be 5
    field(DRVL, "0.0")
    field(DRVH, "99.9")
    field(LOPR, "0.0")
    field(HOPR, "99.9")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Enable/Disable External Trigger
#
record(bo, "$(device):$(head):SetExtTrig")
{
    field(DESC, "External Trigger")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_exttrig($(channel)) $(port)")
    # Manual p.33: *ET requires acquisition stopped (*CS) first
    field(SDIS, "$(device):$(head):DisReadingValue")
    field(DISV, "1")
    field(DISS, "MINOR")
    field(ZNAM, "Disable")
    field(ONAM, "Enable")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Detector Name
#
record(stringin, "$(device):$(head):Name") 
{
    field(DESC, "Detector Name")
    field(DTYP, "stream")
    field(INP,  "@gentecSLink.proto get_name($(channel)) $(port)")
    field(PINI, "YES")
}

################################################################################
# Detector Serial Number
#
record(stringin, "$(device):$(head):Serial") 
{
    field(DESC, "Serial Number")
    field(DTYP, "stream")
    field(INP,  "@gentecSLink.proto get_serial($(channel)) $(port)")
    field(PINI, "YES")
}

################################################################################
# Scale


record(stringout, "$(device):$(head):SetScale") {
    field(DESC, "User-set scale string (e.g. 10nJ, 1mW)")
    field(FLNK, "$(device):$(head):SetScaleStrToInt")
}
record(aSub, "$(device):$(head):SetScaleStrToInt") {
    field(DESC, "Convert scale string to int index")
    field(INPA, "$(device):$(head):SetScale")    # Comes from stringout
     field(FTA, "STRING")
    field(FTVA, "LONG")
    field(NEVA, "1")
    field(SNAM, "energyStrToInt")
    # Unknown string: subroutine returns non-zero, OUTA is not written,
    # nothing is sent to the device and this record goes MINOR.
    field(BRSV, "MINOR")
    field(OUTA, "$(device):$(head):SendScaleIndex PP")
}
record(longout, "$(device):$(head):SendScaleIndex") {
    field(DESC, "Send scale index to device")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto set_scale($(channel)) $(port)")
    # Manual p.35: *SC requires acquisition stopped (*CS) first
    field(SDIS, "$(device):$(head):DisReadingValue")
    field(DISV, "1")
    field(DISS, "MINOR")
    field(DRVL, "0")
    field(DRVH, "41")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Assign values of SetScale with Scale after IOC Init to restore autosave value
#
record(calcout, "$(device):$(head):SetScaleInit") 
{
    field(CALC, "a")
    field(INPA, "$(device):$(head):Scale")
    field(OUT, "$(device):$(head):SetScale PP")
}

record(stringin, "$(device):$(head):HeadName")
{
    field(VAL, "$(head_name)")
    field(PINI, "YES")
}

################################################################################
# Proactive RBV refresh on asyn (re)connect: covers the device being
# unreachable at iocInit (PINI reads fail) and any later link drop.
#
record(calcout, "$(device):$(head):RefreshOnConnect")
{
    field(DESC, "Refresh RBVs on reconnect")
    field(INPA, "$(device):ConnectionState CP")
    field(CALC, "A")
    field(OOPT, "Transition To Non-zero")
    field(OUT,  "$(device):$(head):RefreshRBV.PROC PP")
}

# Edge refresh once the port is quiet again (last streaming channel
# stopped). ODLY lets the final in-flight data line drain first.
record(calcout, "$(device):$(head):RefreshOnIdle")
{
    field(DESC, "Refresh RBVs when streaming stops")
    field(INPA, "$(device):Streaming CP")
    field(CALC, "A")
    field(OOPT, "Transition To Zero")
    field(ODLY, "0.5")
    field(OUT,  "$(device):$(head):RefreshRBV.PROC PP")
}

record(fanout, "$(device):$(head):RefreshRBV")
{
    field(DESC, "Re-read device readbacks")
    field(SDIS, "$(device):Streaming")
    field(DISV, "1")
    field(SELM, "All")
    field(LNK1, "$(device):$(head):Status")
    field(LNK2, "$(device):$(head):Name")
    field(LNK3, "$(device):$(head):Serial")
    field(LNK4, "$(device):$(head):MinRange")
}
