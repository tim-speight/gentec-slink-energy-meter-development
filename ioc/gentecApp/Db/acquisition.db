################################################################################
# Acquisition State
# CSS based on its value grayes out gui elements
#
record(mbbo, "$(device):$(head):AcquisitionState"){
    field(ZRVL,"0")
    field(ONVL, "1")
    field(TWVL, "2")
    field(ZRST, "Undefined")
    field(ONST, "Stopped")
    field(TWST, "Started")
    field(VAL,"0")
    field(PINI,"YES")
    field(FLNK, "$(device):$(head):DisReadingValue")
}

################################################################################
# Start Acquisition (streaming, manual p.31)
# Order matters: state -> Streaming gate raised (solicited reads on the
# shared port suppressed) -> then *CA sent by SendStartAcq.
#
record(bo, "$(device):$(head):StartAcquisition")
{
    field(DESC, "Start")
    field(FLNK, "$(device):$(head):SetAcqStateToStart")
}

record(longout, "$(device):$(head):SetAcqStateToStart") {
    field(VAL, "2")
    field(OUT, "$(device):$(head):AcquisitionState PP")
    field(FLNK, "$(device):$(head):SendStartAcq")
}

record(bo, "$(device):$(head):SendStartAcq")
{
    field(DESC, "Send *SS/*VNP/*CA")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto start_acq($(channel)) $(port)")
}

################################################################################
# Read latest power measurement
#
record(ai, "$(device):$(head):Value")
{
    field(DESC, "Energy")
    field(EGU,  "$(egu=J)")
    field(PREC, "4")
    field(DTYP, "stream")
    # One process per laser pulse: the datum arrives unsolicited on the
    # ASCII stream the instant the laser hits the head (*CA mode).
    field(INP,  "@gentecSLink.proto get_value_con($(channel)) $(port)")
    field(SCAN, "I/O Intr")
    field(FLNK,"$(device):$(head):RangeFraction")
}

# 1 while this head is Started. Gates the *CS-only setters on this head and
# publishes this channel's state to the device-level $(device):Streaming gate.
record(calcout, "$(device):$(head):DisReadingValue"){
    field(INPA, "$(device):$(head):AcquisitionState")
    field(CALC, "A  == 2 ? 1 : 0")
    field(OOPT, "Every Time")
    field(OUT,  "$(device):StreamCh$(channel) PP")
    field(PINI, "YES")
}

################################################################################
# Over-metering / saturation: raw reading as a fraction of the selected range
# full scale. Full scale derived from the Scale index ladder used by
# scale_mapper.c (index 0 = 1pJ; 1,3,10,30,100,300 per decade triple).
#
record(calc, "$(device):$(head):RangeFraction") {
    field(DESC, "Reading / range full scale")
    field(INPA, "$(device):$(head):Value MS")
    field(INPB, "$(device):$(head):Scale")
    field(CALC, "A/((B%6=0?1:B%6=1?3:B%6=2?10:B%6=3?30:B%6=4?100:300)*10^(3*FLOOR(B/6)-12))")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "1.2")
    field(HIGH, "$(RANGE_HIGH=0.9)")
    field(HIHI, "$(RANGE_HIHI=1.0)")
    field(HSV,  "MINOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(device):$(head):CalibratedValue")
}

record(ai, "$(device):$(head):MultiplierFactor") {
    field(VAL,"1")
    field(PINI,"YES")
    field(FLNK, "$(device):$(head):CalibratedValue")
    field(LOPR, 0)
    field(HOPR, "1000000")
}

record(ai, "$(device):$(head):OffsetFactor") {
    field(VAL,"0")
    field(PINI,"YES")
    field(FLNK, "$(device):$(head):CalibratedValue")
} 

record(calc, "$(device):$(head):CalibratedValue") {
    field(INPA, "$(device):$(head):Value MS")
    field(INPB,"$(device):$(head):MultiplierFactor")
    field(INPC, "$(device):$(head):OffsetFactor")
    field(EGU,  "$(egu=J)")
    field(CALC, "A * B + C")
    field(FLNK, "$(device):$(head):ScaledValue")
}

record(calc, "$(device):$(head):ScaledValue") {
    # Processed only via FLNK from CalibratedValue: one sample in, one
    # sample to :measurement/:statistics.
    field(INPA,"$(device):$(head):Scale")
    field(INPB, "$(device):$(head):CalibratedValue MS")
    field(INPC,"1000000000000")
    field(INPD,"1000000000")
    field(INPE,"1000000")
    field(INPF,"1000")
    field(INPG,"1")
    field(INPH,"0.001")
    field(INPI,"0.000001")
    field(CALC, "A<6?(B*C):A<12?(B*D):A<18?(B*E):A<24?(B*F):A<30?(B*G):A<36?(B*H):(B*I)")
    field(FLNK, "$(device):$(head):measurement")
}

################################################################################
# Stop Acquisition
#
record(bo, "$(device):$(head):StopAcquisition"){
    field(DESC, "Stop")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto stop_acq($(channel)) $(port)")
    field(FLNK, "$(device):$(head):SetAcqStateToStop")
}

# *CS is sent first (StopAcquisition), then the gate drops. RBVs are
# refreshed by RefreshOnIdle once no channel is streaming.
record(bo, "$(device):$(head):SetAcqStateToStop") {
    field(VAL, "1")
    field(OUT, "$(device):$(head):AcquisitionState PP")
}


################################################################################
# Min Range
#
record(longin, "$(device):$(head):MinRange"){
    field(DESC, "Minimum Range")
    field(DTYP, "stream")
    field(INP,  "@gentecSLink.proto get_range($(channel),$(device),$(head)) $(port)")
    field(LOPR, "0")
    field(HOPR, "41")
    field(LOW,  "-1")
    field(HIGH, "42")
    field(LOLO, "-1")
    field(HIHI, "42")
    field(LSV,  "MINOR")
    field(HSV,  "MINOR")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
    field(FLNK, "$(device):$(head):MaxRange")
    field(PINI,"YES")
}

################################################################################
# Max Range
#
record(longin, "$(device):$(head):MaxRange"){
    field(DESC, "Maximum Range")
    field(LOPR, "0")
    field(HOPR, "41")
    field(LOW,  "-1")
    field(HIGH, "42")
    field(LOLO, "-1")
    field(HIHI, "42")
    field(LSV,  "MINOR")
    field(HSV,  "MINOR")
    field(LLSV, "MAJOR")
    field(HHSV, "MAJOR")
}

################################################################################
# Scale Up
#
record(bo, "$(device):$(head):ScaleUp"){
    field(DESC, "Scale up")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto scale_up($(channel)) $(port)")
    # Manual p.33: *SU requires acquisition stopped (*CS) first
    field(SDIS, "$(device):$(head):DisReadingValue")
    field(DISV, "1")
    field(DISS, "MINOR")
    field(FLNK, "$(device):$(head):Status")
}

################################################################################
# Scale Down
#
record(bo, "$(device):$(head):ScaleDown"){
    field(DESC, "Scale down")
    field(DTYP, "stream")
    field(OUT,  "@gentecSLink.proto scale_down($(channel)) $(port)")
    # Manual p.33: *SD requires acquisition stopped (*CS) first
    field(SDIS, "$(device):$(head):DisReadingValue")
    field(DISV, "1")
    field(DISS, "MINOR")
    field(FLNK, "$(device):$(head):Status")
}
